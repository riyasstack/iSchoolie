# ---------------------------------------------------------------------------
# iSchoolie — production build environment
#
# Copy to `.env.production` (or set the same variables in your CI provider) and
# run `npm run build`. Every NEXT_PUBLIC_* value is compiled into the static
# bundle and is readable by anyone who loads the site: never put a secret here.
#
# `.env.local` takes precedence over `.env.production` in Next.js. Remove or
# empty it before a real build, or the emulator settings will be baked in.
# ---------------------------------------------------------------------------

# Must be false for every build that talks to the real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Firebase console → Project settings → Your apps → Web app → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Origin used inside password-reset and email-verification links. It must be
# listed under Authentication → Settings → Authorized domains, and match this
# deployment exactly: https, no trailing slash, no path.
NEXT_PUBLIC_APP_ORIGIN=https://your-domain.example

# Authentication → Settings → Cloud Messaging → Web Push certificates →
# public key. Leave empty to hide push notifications from the UI.
NEXT_PUBLIC_FCM_VAPID_KEY=

# Optional sign-in providers: only enable those configured in the console.
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
NEXT_PUBLIC_AUTH_LINKEDIN_ENABLED=false
