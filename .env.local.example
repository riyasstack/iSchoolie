# ---------------------------------------------------------------------------
# iSchoolie — public Firebase configuration (browser-safe, NOT secrets)
# Copy to .env.local and fill in from Firebase console -> Project settings.
#
# These values identify your project to the Firebase SDK. They are shipped in
# the client bundle by design. Real protection comes from Firestore Security
# Rules, not from hiding these.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCbztZKwVze2lN-mHKTM_N8mE7OcYl4ESw
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ischoolie.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ischoolie
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ischoolie.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=581941532239
NEXT_PUBLIC_FIREBASE_APP_ID=1:581941532239:web:19a4a9a7f84e0c6ce03c3a
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-BX4ZJYTL5T

# Optional: set to "true" to use the Firebase Local Emulator Suite.
# When enabled, Auth uses 127.0.0.1:9099 and Firestore uses 127.0.0.1:8080.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Optional: canonical public origin used in emails/links (no trailing slash).
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Optional provider switches. Leave false unless the provider is *actually*
# configured in Firebase Auth. A hidden button is better than a broken one.
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
NEXT_PUBLIC_AUTH_LINKEDIN_ENABLED=false

# ---------------------------------------------------------------------------
# Server-only (NEVER prefix with NEXT_PUBLIC_ and never import in src/).
# Used exclusively by the local admin CLI in scripts/admin.
# Point this at the downloaded service-account JSON. Keep it out of git.
# ---------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=./.service-account.json
# FIREBASE_PROJECT_ID=your-project
# Use the emulator from the admin CLI too (no credentials needed):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- WorkOS AuthKit ---
# Server-only keys come from https://dashboard.workos.com → API Keys.
WORKOS_CLIENT_ID="client_..."
WORKOS_API_KEY="sk_test_..."
# Encrypts the session cookie. Must be at least 32 characters: `openssl rand -base64 24`
WORKOS_COOKIE_PASSWORD="..."
# Must match Applications → Redirects → Redirect URI.
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"
